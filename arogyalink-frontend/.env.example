# Copy this file to .env and fill in your values

# Backend API URL (no trailing slash)
VITE_API_URL=http://localhost:8082

# Firebase Web SDK config
# Get these from Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=solution-challenge-cb95c.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://solution-challenge-cb95c-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=solution-challenge-cb95c
VITE_FIREBASE_STORAGE_BUCKET=solution-challenge-cb95c.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
