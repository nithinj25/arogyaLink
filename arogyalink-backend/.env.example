# Google AI Studio — Gemma 4
GEMMA_API_KEY=your_google_ai_studio_api_key
GEMMA_MODEL=gemma-2-27b-it

# Google Cloud
GOOGLE_MAPS_API_KEY=your_maps_api_key
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Firebase
FIREBASE_DATABASE_URL=https://arogyalink-prod-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=arogyalink-prod

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# App
PORT=8080
ENV=development
APP_BASE_URL=https://YOUR_CLOUD_RUN_URL
