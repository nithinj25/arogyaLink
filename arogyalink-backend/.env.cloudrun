# These env vars go into Cloud Run → Edit & Deploy → Variables & Secrets
# Do NOT commit actual secrets — use Cloud Run secrets or Secret Manager

GEMMA_API_KEY=<your-google-ai-studio-key>
GEMMA_MODEL=gemini-2.0-flash
GOOGLE_MAPS_API_KEY=<your-maps-key>

FIREBASE_DATABASE_URL=https://solution-challenge-cb95c-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=solution-challenge-cb95c

TWILIO_ACCOUNT_SID=<your-twilio-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_PHONE_NUMBER=<your-twilio-number>

PORT=8080
ENV=production
# Set this AFTER your Cloud Run service is deployed — it's the service URL
APP_BASE_URL=https://arogyalink-backend-<hash>-el.a.run.app
